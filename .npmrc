# Allow packages with native build scripts (esbuild, etc.) to run them.
  # onlyBuiltDependencies in pnpm-workspace.yaml covers pnpm v9;
  # approve-builds covers pnpm v10+ (used by Render via npx pnpm).
  approve-builds=true

  # Install devDependencies even when NODE_ENV=production.
  # Render sets NODE_ENV=production during builds, which normally causes pnpm
  # to skip devDependencies — but this app needs vite and other build tools.
  prod=false
  